{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "version": "0.12.26",
  "description": "__MSG_extensionDescription__",
  "browser_specific_settings": {
    "gecko": {
      "id": "mail-ai-assist@lvbeck.github.com",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "compose",
    "scripting",
    "nativeMessaging",
    "storage",
    "messagesRead",
    "messagesUpdate",
    "messagesTags",
    "menus",
    "accountsRead",
    "clipboardWrite"
  ],
  "background": {
    "scripts": [
      "toolbar.js",
      "background.js",
      "mail-content.js",
      "mail-export.js",
      "mail-background.js",
      "tag-instructions.js",
      "summary-instructions.js",
      "auto-tags.js",
      "auto-summary.js",
      "account-menu.js",
      "onboarding.js"
    ],
    "persistent": true
  },
  "compose_action": {
    "default_title": "__MSG_assistantLabel__",
    "default_label": "__MSG_assistantLabel__",
    "default_icon": "icon-menu.svg",
    "type": "menu"
  },
  "icons": {
    "16": "icon-menu.svg",
    "32": "icon-menu.svg",
    "48": "icon.svg",
    "64": "icon.svg",
    "128": "icon.svg"
  },
  "author": "Jin Lu",
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "default_locale": "en",
  "message_display_action": {
    "default_title": "__MSG_assistantLabel__",
    "default_label": "__MSG_assistantLabel__",
    "default_icon": "icon-menu.svg",
    "default_popup": "mail-menu.html"
  }
}
